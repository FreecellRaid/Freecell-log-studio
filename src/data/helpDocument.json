{
    "title": "帮助文档",
    "closeTitle": "关闭帮助 (Esc)",
    "sections": [
        {
            "type": "tips",
            "icon": "FolderOpen",
            "title": "快速上手",
            "items": [
                {
                    "term": "整理流程",
                    "description": "导入日志 → 整理场景和身份 → 编辑消息与染色 → 选择模板并预览 → 导出与保存工程"
                },
                {
                    "term": "保存与备份",
                    "description": "保存到本地用于当前浏览器恢复(通过链接导入时不会影响服务器数据)；导出为工程文件用于备份或迁移"
                }
            ]
        },
        {
            "type": "tips",
            "icon": "Upload",
            "title": "文件导入",
            "items": [
                {
                    "term": "选择文件",
                    "description": "点击顶部导入按钮，可选择一个或多个日志文件"
                },
                {
                    "term": "拖入工作区（桌面端）",
                    "description": "任意时刻将文件拖入中间工作区即可导入"
                },
                {
                    "term": "从剪切板导入",
                    "description": "点击顶部导入按钮，可直接导入剪切板中的日志文本"
                },
                {
                    "term": "从链接导入",
                    "description": "支持青果、海豹日志链接及公开的 HTTPS 文本/JSON 直链；直链服务须允许跨域读取，默认下载上限 10 MiB、超时 30 秒"
                },
                {
                    "term": "删除场外括号",
                    "description": "默认关闭，可在偏好设置（移动端左侧菜单）启用。导入时删除场外发言首尾各一个括号，仅影响后续日志导入，仍保留场外标记"
                },
                {
                    "term": "DOCX 导入",
                    "description": "只提取纯文本，不保留原文件的样式和图片；提取出的文字仍须符合支持的日志格式"
                },
                {
                    "term": "文本清洗",
                    "description": "提取 CQ 图片和 HTML img，其他 CQ 码暂时删除，HTML 保留可见纯文本；图片显示在正文之后"
                },
                {
                    "term": "工程导入",
                    "description": "工程 JSON 仅支持单文件导入，会替换当前工作区；普通日志追加为新文档。导入成功会清空撤销历史"
                }
            ]
        },
        {
            "type": "tips",
            "icon": "MessageSquare",
            "title": "消息操作",
            "items": [
                {
                    "term": "双击消息正文（桌面端）",
                    "description": "进入编辑，Enter 保存，Shift + Enter 换行，Esc 取消；点击编辑区外也会保存"
                },
                {
                    "term": "拖拽消息",
                    "description": "移动消息"
                },
                {
                    "term": "Ctrl + 点击",
                    "description": "多选消息，macOS 使用 Command + 点击"
                },
                {
                    "term": "Shift + 点击",
                    "description": "范围选择"
                },
                {
                    "term": "Markdown",
                    "description": "启用后在消息、导出预览和 HTML 中渲染；DOCX 支持部分格式，TEXT 保留源文本"
                }
            ]
        },
        {
            "type": "tips",
            "icon": "FolderOpen",
            "title": "场景管理",
            "items": [
                {
                    "term": "场景划分",
                    "description": "默认按相邻消息的日期变化分块，不自动识别剧情场景；可手动拆分与合并"
                },
                {
                    "term": "双击名称",
                    "description": "重命名"
                },
                {
                    "term": "拖拽场景",
                    "description": "移动场景"
                },
                {
                    "term": "向下合并",
                    "description": "合并相邻场景"
                }
            ]
        },
        {
            "type": "tips",
            "icon": "UserRound",
            "title": "角色/账号管理",
            "items": [
                {
                    "term": "切换模式",
                    "description": "点击角色/账号标题旁图标可切换管理模式"
                },
                {
                    "term": "双击名称",
                    "description": "重命名身份，会同步更新所有关联消息"
                },
                {
                    "term": "下拉选择",
                    "description": "修改身份角色"
                },
                {
                    "term": "点击色块",
                    "description": "修改该身份的染色"
                }
            ]
        },
        {
            "type": "tips",
            "icon": "Palette",
            "title": "自定义染色规则",
            "items": [
                {
                    "term": "优先级",
                    "description": "数字越大越优先；匹配规则按颜色、加粗、斜体分别叠加，高优先级未设置的效果仍保留低优先级设置"
                },
                {
                    "term": "筛选条件",
                    "description": "不同条件须同时满足；文本字段用逗号分隔的关键词满足任意一个即可，按包含关系匹配"
                },
                {
                    "term": "样式效果",
                    "description": "颜色、加粗和斜体可独立启用，并可分别作用于名字或内容"
                },
                {
                    "term": "选区绑定",
                    "description": "可将当前选中的消息直接绑定到规则"
                }
            ]
        },
        {
            "type": "tips",
            "icon": "TextInitial",
            "title": "导出模板占位符",
            "items": [
                {
                    "term": "{{name}}",
