                },
                {
                    "term": "{{contentColor}}",
                    "description": "样式规则叠加后的内容颜色；未设置颜色时为空字符串"
                },
                {
                    "term": "{{imageName}}",
                    "description": "图片附件名称"
                },
                {
                    "term": "{{imageUrl}}",
                    "description": "图片附件链接"
                },
                {
                    "term": "{{image}}",
                    "description": "图片附件本身"
                },
                {
                    "term": "\\t",
                    "description": "制表符"
                },
                {
                    "term": "\\n",
                    "description": "换行符"
                },
                {
                    "term": "填写规则",
                    "description": "名称区分大小写，括号内不要加空格；幕间/场景分隔符中的 {{name}} 分别表示文档名/场景名"
                }
            ]
        },
        {
            "type": "tips",
            "icon": "TextInitial",
            "title": "导出与过滤",
            "items": [
                {
                    "term": "导出格式",
                    "description": "顶部导出菜单提供 TEXT、HTML、DOCX、剪切板及工程文件；DOC 当前没有菜单入口"
                },
                {
                    "term": "文件后缀",
                    "description": "模板后缀仅用于 TEXT 导出，例如 .txt 或 .md；HTML 和 DOCX 使用固定后缀"
                },
                {
                    "term": "隐藏消息",
                    "description": "隐藏场外或指令消息也会从导出预览、文件及导出到剪切板中排除对应消息，工程 JSON 仍保留全部消息"
                },
                {
                    "term": "显示已隐藏消息",
                    "description": "只影响编辑区显示，不会把隐藏消息重新加入导出"
                },
                {
                    "term": "Markdown 限制",
                    "description": "图片附件可单独导出：HTML/DOC 内嵌本地副本，DOCX 内嵌并缩小大图，WebP 转为 PNG；TEXT 输出 Data URI。"
                }
            ]
        },
        {
            "type": "tips",
            "icon": "FolderOpen",
            "title": "保存、恢复与撤销",
            "items": [
                {
                    "term": "手动保存",
                    "description": "工程不会自动保存或在刷新后自动恢复；桌面端使用保存和本地工程入口，移动端在左侧菜单保存并恢复最新快照"
                },
                {
                    "term": "工程备份",
                    "description": "导出为工程文件保存所有消息、样式规则和工程视图设置；导出模板与其他 UI 偏好不包含在工程中"
                },
                {
                    "term": "替换工作区",
                    "description": "恢复快照或导入工程会替换当前工作区，有内容时询问确认；撤销历史不会随工程保存"
                },
                {
                    "term": "存储空间",
                    "description": "工程存入 IndexedDB，旧版存档自动迁移并保留原始备份；清除站点数据会丢失快照。空间不足时保存失败但不会删除旧工程，重要工程请导出 JSON 备份"
                },
                {
                    "term": "撤销范围",
                    "description": "最多保留 20 步编辑历史；导入日志、导入工程或恢复快照会清空历史，不能通过撤销回到导入前"
                }
            ]
        },
        {
            "type": "tips",
            "icon": "MessageSquare",
            "title": "移动端操作",
            "items": [
                {
                    "term": "面板入口",
                    "description": "底部切换场景、身份、染色、搜索和模板，顶部提供导入与导出，左侧菜单提供保存、恢复和偏好设置"
                },
                {
                    "term": "选择与编辑",
                    "description": "点击消息选中，再次点击取消；点击消息的编辑按钮修改正文、角色、账号和标记"
                },
                {
                    "term": "长按排序",
                    "description": "长按消息约半秒后拖动，在当前场景内重排；靠近列表边缘可自动滚动，松手完成移动"
                },
                {
                    "term": "撤销与重做",
                    "description": "有编辑历史时，使用底部上方的悬浮撤销/重做按钮"
                }
            ]
        },
